#!/bin/bash

# SPDX-FileCopyrightText: 2026 Uwe Fechner
# SPDX-License-Identifier: MIT

set -eu

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.."

usage() {
    cat <<'USAGE'
Usage: bin/install [-y] [--update] [-h]

Install the package environment of this repository for the Julia version that is
on the machine: every other manifest, here and in the sub-projects, is moved to
.bak, the tracked Manifest-v<version>.toml.default is copied over the live
Manifest-v<version>.toml, instantiated and precompiled. Nothing outside the
repository changes but the depot ~/.julia.

  -y        accepted for scripts; bin/install asks nothing either way
  --update  resolve instead of install: Pkg.update against the live manifest,
            leaving the tracked default alone
  -h        show this message
USAGE
}

update=false
while [ $# -gt 0 ]; do
    case "$1" in
        -y) ;;
        --update) update=true ;;
        -h|--help) usage; exit 0 ;;
        *) echo "bin/install: unknown option $1" >&2; usage >&2; exit 1 ;;
    esac
    shift
done

if ! command -v julia > /dev/null; then
    echo "bin/install: no julia on the PATH; install it with juliaup first." >&2
    exit 1
fi

export JULIA_PKG_SERVER_REGISTRY_PREFERENCE=eager

if $update; then
    julia --startup-file=no --project -e 'using Pkg; Pkg.update()'
    exit 0
fi

version=$(julia --startup-file=no -e 'print("v", VERSION.major, ".", VERSION.minor)')
manifest="Manifest-$version.toml"
if [ ! -f "$manifest.default" ]; then
    echo "bin/install: no $manifest.default; this repo does not pin Julia $version." >&2
    exit 1
fi

for stale in Manifest*.toml */Manifest*.toml; do
    if [ -f "$stale" ] && [ "$stale" != "$manifest" ]; then
        mv "$stale" "$stale.bak"
        echo "bin/install: moved $stale to $stale.bak."
    fi
done

cp "$manifest.default" "$manifest"
julia --startup-file=no --project -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'

if julia --startup-file=no -e 'exit(Base.find_package("Revise") === nothing ? 1 : 0)'; then
    bin/run_julia < /dev/null > /dev/null
else
    echo "bin/install: Revise is not in your global environment; bin/run_julia runs without it." >&2
fi
