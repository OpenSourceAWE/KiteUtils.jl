#!/bin/bash
# Copyright (c) 2026 Bart van de Lint
# SPDX-License-Identifier: MIT

set -euo pipefail

_dry_run=false
_assume_yes=false
_sha=""
_issue=21

print_usage() {
    echo "Usage:"
    echo "  ./bin/release            Register the current HEAD with JuliaRegistrator"
    echo "  ./bin/release --dry-run  Print the version, commit and release notes, then exit"
    echo "  ./bin/release --yes      Skip the confirmation prompt"
    echo "  ./bin/release --sha SHA  Verify SHA instead of HEAD is the pushed tip"
    echo "  ./bin/release -h"
    echo
    echo "Extracts the top section of CHANGELOG.md as release notes and posts a"
    echo "'@JuliaRegistrator register' comment on issue #$_issue via the GitHub API"
    echo "(https://github.com/OpenSourceAWE/KiteUtils.jl/issues/$_issue), the"
    echo "repo's standing release-tracking issue, instead of commenting on the"
    echo "commit directly. JuliaRegistrator then registers the default branch's"
    echo "current HEAD, so the commit must already be pushed to the remote."
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) print_usage; exit 0 ;;
        -n|--dry-run) _dry_run=true; shift ;;
        -y|--yes) _assume_yes=true; shift ;;
        --sha) _sha="${2:?--sha needs an argument}"; shift 2 ;;
        *) echo "Unknown option: $1" >&2; print_usage >&2; exit 1 ;;
    esac
done

if [[ $(basename "$(pwd)") == "bin" ]]; then
    cd ..
fi

for cmd in git gh awk; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "Required command not found: $cmd" >&2
        exit 1
    fi
done

if ! gh auth status >/dev/null 2>&1; then
    echo "gh is not authenticated. Run 'gh auth login' first." >&2
    exit 1
fi

_version=$(awk -F'"' '/^version[[:space:]]*=/ {print $2; exit}' Project.toml)
if [[ -z "$_version" ]]; then
    echo "Could not read version from Project.toml" >&2
    exit 1
fi

_changelog_version=$(awk '/^## / {
    for (i = 1; i <= NF; i++) if ($i ~ /^v[0-9]+\.[0-9]+\.[0-9]+$/) { print $i; exit }
}' CHANGELOG.md)
if [[ "$_changelog_version" != "v$_version" ]]; then
    echo "Version mismatch: Project.toml is $_version but CHANGELOG top is" \
         "$_changelog_version (expected v$_version)." >&2
    echo "Update CHANGELOG.md so its first '## ' header matches the package version." >&2
    exit 1
fi

_notes=$(awk '
    /^## / { n++; if (n == 1) next }
    n == 1 { print }
' CHANGELOG.md | awk '
    { lines[NR] = $0 }
    END {
        start = 1; while (start <= NR && lines[start] ~ /^[[:space:]]*$/) start++
        end = NR; while (end >= start && lines[end] ~ /^[[:space:]]*$/) end--
        for (i = start; i <= end; i++) print lines[i]
    }
')

if [[ -z "$_notes" ]]; then
    echo "No release notes found under the '## v$_version' section." >&2
    exit 1
fi

if [[ -z "$_sha" ]]; then
    _sha=$(git rev-parse HEAD)
fi

if [[ -n "$(git status --porcelain)" ]]; then
    echo "Working tree has uncommitted changes. Commit or stash them first." >&2
    exit 1
fi

_repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)
_default_branch=$(gh api "repos/$_repo" -q .default_branch)
_remote_sha=$(gh api "repos/$_repo/commits/$_default_branch" -q .sha 2>/dev/null || true)

if [[ -z "$_remote_sha" ]]; then
    echo "Could not resolve the remote HEAD of $_default_branch on $_repo." >&2
    exit 1
fi

if [[ "$_remote_sha" != "$_sha" ]]; then
    echo "Commit $_sha is not the tip of $_default_branch on $_repo (that's" \
         "$_remote_sha)." >&2
    echo "JuliaRegistrator registers whatever is at the tip of $_default_branch" \
         "when triggered from issue #$_issue, so push $_sha there first:" >&2
    echo "  git push origin HEAD:$_default_branch" >&2
    exit 1
fi

_body=$(printf '@JuliaRegistrator register\n\nRelease notes:\n\n%s\n' "$_notes")

echo "Repository:   $_repo"
echo "Version:      v$_version"
echo "Commit:       $_sha ($_default_branch)"
echo "Issue:        https://github.com/$_repo/issues/$_issue"
echo
echo "Release notes:"
echo "--------------------------------------------------------------------------"
echo "$_notes"
echo "--------------------------------------------------------------------------"

if [[ "$_dry_run" == true ]]; then
    echo
    echo "Dry run: no comment posted."
    exit 0
fi

if [[ "$_assume_yes" != true ]]; then
    echo
    read -r -p "Post this comment on issue #$_issue and trigger JuliaRegistrator? [y/N] " _reply
    if [[ ! "$_reply" =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 1
    fi
fi

_url=$(gh api "repos/$_repo/issues/$_issue/comments" -f body="$_body" -q .html_url)

echo
echo "Posted: $_url"
echo "JuliaRegistrator will open a PR to the General registry shortly."
